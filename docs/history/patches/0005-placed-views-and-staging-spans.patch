+/// Read defined resource fields without copying ABI padding into the interned view.
+fn placed_resource_words(desc: *const [u32; 14]) -> Option<[u32; 14]> {
+    if desc.is_null() {
+        return None;
+    }
+    let mut fields = [0u32; 14];
+    let from = desc.cast::<u8>();
+    let to = fields.as_mut_ptr().cast::<u8>();
+    // SAFETY: a 56-byte ResourceDesc; copying bytes also permits an unaligned
+    // source. Dimension occupies bytes 0..4, alignment through flags 8..52.
+    unsafe {
+        std::ptr::copy_nonoverlapping(from, to, 4);
+        std::ptr::copy_nonoverlapping(from.add(8), to.add(8), 44);
+    }
+    Some(fields)
+}
+
 /// Device method.
 ///
 /// A null `desc` writes a null CBV (`Constant(0, 0)`), matching D3D12's
@@ -619,7 +636,7 @@ pub(crate) extern "system" fn create_placed_srv(
     desc: *const [u32; 16],
     handle: u64,
 ) {
-    if let (Some(resource), Some(desc)) = (words(resource), words(desc)) {
+    if let (Some(resource), Some(desc)) = (placed_resource_words(resource), words(desc)) {
         record(handle, View::Placed(false, resource, desc));
     }
 }
