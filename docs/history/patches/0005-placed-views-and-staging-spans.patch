         }
     }
+
+    #[cfg(windows)]
+    #[test]
+    fn placed_texture_padding_reuses_the_resource_across_views() {
+        // The runtime caches the resource for this process. Keep its aligned
+        // backing allocation alive for the same lifetime.
+        static TITLE_ADDRESS: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+        let addr = *TITLE_ADDRESS.get_or_init(|| {
+            Box::leak(Box::new(crate::resource::Memory::zeroed(65536, 65536).unwrap())).address()
+        });
+        let mut srv = [0u32; 16];
+        (srv[10], srv[11]) = (addr as u32, (addr >> 32) as u32);
+        let shape = [3, 0, 0, 0, 8, 0, 4, 0x1_0001, 80, 1, 0, 0x105, 0, 0];
+        let mut padded = shape;
+        padded[1] = 0x1234_5678;
+        padded[13] = 0x9abc_def0;
+        let record = |desc: &[u32; 14], unordered: bool| {
+            let mut record = [0u64; 4];
+            let slot = record.as_mut_ptr() as u64;
+            if unordered {
+                create_placed_uav(std::ptr::null(), desc, &srv, slot);
+            } else {
+                create_placed_srv(std::ptr::null(), desc, &srv, slot);
+            }
+            view(slot).unwrap()
+        };
+        let object = |view: &View| match host::placed_texture(view) {
+            Some(View::Shader(resource, _)) => resource,
+            _ => panic!("placed texture resource missing"),
+        };
+        let first = record(&shape, false);
+        let second = record(&padded, false);
+        assert_eq!(object(&first), object(&second), "padding allocated a second resource");
+        assert_eq!(first, second);
+        assert_eq!(record(&shape, true), record(&padded, true));
+        let mut wider = padded;
+        wider[4] = 16;
+        assert_ne!(object(&first), object(&record(&wider, false)));
+    }
 }
