+#[test]
+fn f64_conversion_reports_directed_and_dynamic_rounding() {
+    let cvt = vop1(0x00f, 0, vgpr(1));
+    // Write MODE bits 3:2, first from immediates and then from an SGPR.
+    for setup in [vec![0xBA80_0881, 1], vec![0xBA80_0881, 2],
+                  vec![0xBA80_0881, 3], vec![0xB980_0881]] {
+        let mut body = setup;
+        body.push(cvt);
+        let error = try_build_valu_cs(&body).expect_err("unimplemented rounding must be reported");
+        assert!(error.to_string().contains("64-bit to 32-bit conversion needs known nearest-even rounding"), "{error}");
+    }
