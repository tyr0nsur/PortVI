+/// FP64 literals occupy the high dword, while inline constants use their
+/// binary64 encoding (RDNA2 ISA, section 6.2.1).
+#[test]
+fn f64_conversion_places_literals_and_inline_operands() {
+    for (src, literal, value) in [
+        (255, Some(0xC002_0000), -2.25_f32),
+        (255, Some(0x8000_0000), -0.0_f32),
+        (240, None, 0.5_f32),
+        (248, None, std::f32::consts::FRAC_1_PI * 0.5),
+    ] {
+        let mut body = vec![vop1(0x00f, 0, src)];
+        body.extend(literal);
+        let shader = build_valu_cs(&body);
+        run_cases(&shader, &[[0; 4]], |backend, _, _, got| {
+            assert_eq!(got, value.to_bits(), "{backend}: operand {src}, literal {literal:?}");
+        });
+    }
+}
