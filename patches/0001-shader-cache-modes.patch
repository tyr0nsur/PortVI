+    #[test]
+    fn cache_tracks_translation_modes() {
+        use std::process::Command;
+
+        const DIR: &str = "PORTVI_TEST_CACHE_DIR";
+        const LABEL: &str = "PORTVI_TEST_SHADER_LABEL";
+        const OPTIONS: [&str; 3] = [
+            "VICTORY_WAVE_LOCAL",
+            "VICTORY_MESH_OUTPUT_STRICT",
+            "VICTORY_STRICT_JOINS",
+        ];
+
+        // Each process gets the real, once-per-process build fingerprint. The
+        // converter tags its output so a stale hit is visible without a GPU.
+        if let Some(dir) = std::env::var_os(DIR) {
+            let cache = Cache::open(PathBuf::from(dir)).unwrap();
+            let label = std::env::var(LABEL).unwrap().into_bytes();
+            let translated = AtomicBool::new(false);
+            let result = cached(&cache, build(), b"synthetic program", |_| {
+                translated.store(true, Ordering::Relaxed);
+                Ok(HostShader {
+                    dxil: label.clone(),
+                    ..shader()
+                })
+            })
+            .unwrap();
+            assert_eq!(result.dxil, label, "loaded a shader from a different mode");
+            assert_eq!(
+                translated.load(Ordering::Relaxed),
+                std::env::var_os("PORTVI_TEST_HIT").is_none()
+            );
+            return;
+        }
+
+        let dir = tempfile::tempdir().unwrap();
+        // Repeat the default and strict runs to exercise real warm hits too.
+        let cases = [
+            ("default", None, false),
+            ("local-off", Some((OPTIONS[0], "0")), false),
+            ("idiom", Some((OPTIONS[0], "idiom")), false),
+            ("strict-mesh", Some((OPTIONS[1], "")), false),
+            ("strict-joins", Some((OPTIONS[2], "1")), false),
+            ("default", None, true),
+            ("strict-mesh", Some((OPTIONS[1], "")), true),
+        ];
+        for (label, setting, hit) in cases {
+            let mut child = Command::new(std::env::current_exe().unwrap());
+            child
+                .args(["--exact", "shader_cache::tests::cache_tracks_translation_modes", "--nocapture"])
+                .env(DIR, dir.path())
+                .env(LABEL, label)
+                .env_remove("PORTVI_TEST_HIT");
+            for option in OPTIONS {
+                child.env_remove(option);
+            }
+            if let Some((name, value)) = setting {
+                child.env(name, value);
+            }
+            if hit {
+                child.env("PORTVI_TEST_HIT", "1");
+            }
+            let result = child.output().unwrap();
+            assert!(
+                result.status.success(),
+                "{label}: {}",
+                String::from_utf8_lossy(&result.stderr)
+            );
+        }
+    }
+
