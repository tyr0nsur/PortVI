+    /// The one listed mode, after checking the count/status protocol and the
+    /// fields that never change.
+    fn listed(modes: impl Fn(*mut u32, *mut Mode) -> HRESULT) -> Mode {
+        assert_eq!(modes(std::ptr::null_mut(), std::ptr::null_mut()), E_INVALIDARG);
+        let mut count = 0;
+        assert_eq!(modes(&mut count, std::ptr::null_mut()), S_OK);
+        assert_eq!(count, 1);
+        let mut mode = std::mem::MaybeUninit::<Mode>::uninit();
+        count = 0;
+        assert_eq!(modes(&mut count, mode.as_mut_ptr()), MORE_DATA);
+        count = 4;
+        assert_eq!(modes(&mut count, mode.as_mut_ptr()), S_OK);
+        assert_eq!(count, 1);
+        // SAFETY: written by the successful call above.
+        let mode = unsafe { mode.assume_init() };
+        assert_eq!(mode.refresh, [60, 1]);
+        assert_eq!((mode.format, mode.scanlines, mode.scaling, mode.flags), (0, 1, 0, 0));
+        mode
+    }
