+/// The mode size reported when `VICTORY_DISPLAY_MODE` is unset or invalid.
+const DEFAULT_DISPLAY: (u32, u32) = (3840, 2160);
+/// D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION: the largest swap-chain side.
+const MAX_DISPLAY_SIDE: u32 = 16384;
+
+/// `WIDTHxHEIGHT` with both sides in 1..=16384, or `None`. Negative or
+/// overflowing values fail the `u32` parse.
+fn parse_display_mode(value: &str) -> Option<(u32, u32)> {
+    let (w, h) = value.trim().split_once(['x', 'X'])?;
+    let (w, h) = (w.trim().parse::<u32>().ok()?, h.trim().parse::<u32>().ok()?);
+    let fits = |side: u32| (1..=MAX_DISPLAY_SIDE).contains(&side);
+    (fits(w) && fits(h)).then_some((w, h))
+}
+
+/// The size of the one listed mode: `VICTORY_DISPLAY_MODE=WIDTHxHEIGHT`
+/// (opt-in, read once per process) or 3840x2160. Unlike `VICTORY_WINDOW_MAX`
+/// this changes what the title is told the display is, so a title that sizes
+/// its back buffers from the mode renders and presents at that size.
+fn display_size() -> (u32, u32) {
+    static SIZE: std::sync::OnceLock<(u32, u32)> = std::sync::OnceLock::new();
+    *SIZE.get_or_init(|| {
+        let Some(value) = std::env::var_os("VICTORY_DISPLAY_MODE") else {
+            return DEFAULT_DISPLAY;
+        };
+        let Some(size) = value.to_str().and_then(parse_display_mode) else {
+            tracing::warn!(
+                ?value,
+                "ignoring invalid VICTORY_DISPLAY_MODE; expected WIDTHxHEIGHT, each 1..=16384"
+            );
+            return DEFAULT_DISPLAY;
+        };
+        tracing::info!(width = size.0, height = size.1, "display mode reported to the title");
+        size
+    })
+}
+
