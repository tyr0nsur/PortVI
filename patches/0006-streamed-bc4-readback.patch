@@ -1457,4 +1457,35 @@ mod tests {
     }

+    /// ZLIB then BCPack straight into a title BC4 texture's memory, then the
+    /// GPU's own sampling of its host copy: the texels arrive only through
+    /// the upload the storage write marks changed (`kernel_will_write`).
+    /// `PORTVI_BC4_REQUIRE_HARDWARE=1` refuses a software adapter.
+    #[test]
+    fn streamed_bc4_texels_survive_a_real_gpu_upload() {
+        with_test_tables();
+        let packed = miniz_oxide::deflate::compress_to_vec_zlib(&BC4_STREAM, 6);
+        let (_dir, file) = file_with(&packed);
+        let (queue, array) = (new_queue(0), status_array(1));
+        let require_hardware = std::env::var_os("PORTVI_BC4_REQUIRE_HARDWARE").is_some();
+        victory_gpu::resource::bc4_probe::run(
+            |blocks| {
+                let destination = blocks.as_mut_ptr().cast();
+                let mut r = request(ZLIB | 4 << 1, destination, 16, file, 0, packed.len());
+                r.intermediate_size = BC4_STREAM.len() as u32;
+                enqueue(queue, &r);
+                enqueue_status(queue, array, 0);
+                void(queue, 0x30);
+                assert_eq!(wait(array, 0), S_OK);
+                assert_eq!(*blocks, bc4_blocks(), "BCPack output in the console texture");
+            },
+            require_hardware,
+        );
+        void(queue, 0x40);
+        for object in [queue, array, file] {
+            let release: extern "system" fn(*mut c_void) -> u32 = call(object, 0x10);
+            release(object);
+        }
+    }
+
     #[test]
     fn bcpack_requests_unpack_into_the_destination() {
