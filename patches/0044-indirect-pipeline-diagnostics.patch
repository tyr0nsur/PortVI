+/// Counts one indirect call that found no host pipeline.
+#[cfg(all(windows, feature = "diagnostics"))]
+pub(crate) fn note_indirect_pipeline_drop(kind: u32, this: This) {
+    let reason = pipeline_drop_reason(this);
+    // The compilation worker can publish a pipeline after the call gave up.
+    let cause = reason.as_ref().map_or("ready-after-drop", |(cause, _)| *cause);
+    {
+        let mut counts = INDIRECT_PIPELINE_DROPS.lock().unwrap_or_else(|e| e.into_inner());
+        *counts.entry((kind, cause)).or_default() += 1;
+    }
+    if !this.is_null() {
+        make::log_indirect_drop(&pipeline(this).host.key, kind, cause);
+    }
+    if let Some((_, why)) = reason {
         note_why(why);
     }
 }

+#[cfg(all(windows, feature = "diagnostics"))]
+pub(crate) fn log_indirect_pipeline_drops(frames: f64) {
+    let counts = std::mem::take(
+        &mut *INDIRECT_PIPELINE_DROPS.lock().unwrap_or_else(|e| e.into_inner()),
+    );
+    for ((kind, cause), calls) in counts {
+        tracing::info!(kind, cause, calls, calls_per_frame = calls as f64 / frames,
+            "indirect calls without a host pipeline");
+    }
+}
