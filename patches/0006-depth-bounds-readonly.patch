+    #[test]
+    fn bounds_only_host_state_preserves_depth_and_stencil_settings() {
+        let mut g = GraphicsState::default();
+        g.depth_bounds = true;
+        g.depth.DepthEnable = false.into();
+        g.depth.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+        g.depth.DepthFunc = D3D12_COMPARISON_FUNC_LESS;
+        g.depth.StencilEnable = true.into();
+        assert!(!g.depth1().DepthEnable.as_bool(), "no depth format");
+
+        g.depth_format = DXGI_FORMAT_D32_FLOAT;
+        let bounds = g.depth1();
+        assert!(bounds.DepthEnable.as_bool() && bounds.DepthBoundsTestEnable.as_bool());
+        assert_eq!(bounds.DepthWriteMask, D3D12_DEPTH_WRITE_MASK_ZERO);
+        assert_eq!(bounds.DepthFunc, D3D12_COMPARISON_FUNC_ALWAYS);
+        assert!(bounds.StencilEnable.as_bool());
+
+        g.depth.DepthEnable = true.into();
+        let regular = g.depth1();
+        assert_eq!(regular.DepthWriteMask, D3D12_DEPTH_WRITE_MASK_ALL);
+        assert_eq!(regular.DepthFunc, D3D12_COMPARISON_FUNC_LESS);
+        g.depth.DepthEnable = false.into();
+        g.depth_bounds = false;
+        assert!(!g.depth1().DepthEnable.as_bool());
+    }
+
