+#[cfg(windows)]
+struct LinkedPair {
+    mesh: Arc<Shader>,
+    pixel: Option<Arc<Shader>>,
+}
+
+/// A linked pair's key: what the translation depends on besides the
+/// containers (`shader_cache::linked_build`: translator, loop limit,
+/// options, view heap size and title bound), then the mesh and pixel
+/// containers' full hashes.
+#[cfg(windows)]
+type LinkedKey = ([u8; 32], [u8; 32], Option<[u8; 32]>);
+
+#[cfg(windows)]
+impl Shader {
+    fn from_translated(stage: &'static str, hash: String, translated: Translated) -> Arc<Shader> {
+        let cell = OnceLock::new();
+        let _ = cell.set(Some(translated));
+        Arc::new(Shader {
+            stage,
+            hash,
+            container: Vec::new(),
+            translated: cell,
+        })
+    }
+}
+
+/// Re-translates a mesh shader together with its paired pixel shader (if any)
+/// so arbitrary mesh outputs unread by the pixel shader are pruned under
+/// D3D12's 32 KiB mesh output limit (`victory_shader::emit::MESH_OUTPUT_LIMIT`).
+///
+/// Made as the standalone translations are (`shader_cache`: the same
+/// options, under the view heap size and title bound in force now,
+/// snapshotted once for the key and the translation), and kept per that
+/// key. `None` (the caller keeps the standalone translations) unless both
+/// stages asked for come back, of their stages, with the mesh shader's
+/// measured outputs within the limit; a refusal is kept too, a pair that
+/// failed those checks is never kept as a success.
+#[cfg(windows)]
+pub(crate) fn translate_linked(
+    ms: &Shader,
+    ps: Option<&Shader>,
+) -> Option<(Arc<Shader>, Option<Arc<Shader>>)> {
+    static LINKED: Mutex<Option<HashMap<LinkedKey, Option<LinkedPair>>>> = Mutex::new(None);
+    if ms.stage != "mesh" || ps.is_some_and(|p| p.stage != "pixel") {
+        return None;
+    }
+    let (build, profile) = crate::shader_cache::linked_build();
+    let key: LinkedKey = (
+        build,
+        *blake3::hash(&ms.container).as_bytes(),
+        ps.map(|p| *blake3::hash(&p.container).as_bytes()),
+    );
+    if let Some(hit) = LINKED
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .as_ref()
+        .and_then(|m| m.get(&key))
+    {
+        return hit
+            .as_ref()
+            .map(|pair| (pair.mesh.clone(), pair.pixel.clone()));
+    }
+    let made = crate::shader_cache::translate_linked(
+        profile,
+        &ms.container,
+        ps.map(|p| p.container.as_slice()),
+    )
+    .and_then(|(ms_host, ps_host)| linked_pair(ms, ps, ms_host, ps_host));
+    let result = match made {
+        Ok((pair, bytes)) => {
+            tracing::info!(
+                mesh = %ms.hash,
+                pixel = ps.map_or("none", |p| p.hash.as_str()),
+                bytes,
+                "mesh and pixel linked under 32 KiB output budget"
+            );
+            Some(pair)
+        }
+        Err(e) => {
+            tracing::warn!(
+                mesh = %ms.hash,
+                pixel = ps.map_or("none", |p| p.hash.as_str()),
+                error = %e,
+                "linked mesh/pixel translation failed; using standalone translation"
+            );
+            None
+        }
+    };
+    let out = result
+        .as_ref()
+        .map(|pair| (pair.mesh.clone(), pair.pixel.clone()));
+    LINKED
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get_or_insert_with(HashMap::new)
+        .insert(key, result);
+    out
+}
+
+/// The linked shaders, with the console resources their containers' code
+/// reads (as standalone translations get them), and the mesh shader's
+/// measured output bytes; an error unless every stage asked for came back
+/// as that stage and the mesh shader fits the output limit.
+#[cfg(windows)]
+fn linked_pair(
+    ms: &Shader,
+    ps: Option<&Shader>,
+    ms_host: victory_shader::emit::HostShader,
+    ps_host: Option<victory_shader::emit::HostShader>,
+) -> Result<(LinkedPair, u32), String> {
+    use victory_shader::HwStage;
+    if ms_host.stage != HwStage::Ms {
+        return Err("the linked mesh stage is not a mesh shader".into());
+    }
+    let bytes = victory_shader::emit::mesh_output_bytes(&ms_host.dxil)
+        .ok_or("the linked mesh shader has no measurable outputs")?;
+    if bytes > victory_shader::emit::MESH_OUTPUT_LIMIT {
+        return Err(format!("the linked mesh shader's outputs take {bytes} bytes"));
+    }
+    let pixel = match (ps, ps_host) {
+        (Some(p), Some(host)) if host.stage == HwStage::Ps => Some(Shader::from_translated(
+            p.stage,
+            p.hash.clone(),
+            with_resources(&p.container, host)?,
+        )),
+        (None, None) => None,
+        _ => return Err("the linked pair lacks the pixel stage asked for".into()),
+    };
+    let mesh = Shader::from_translated(
+        ms.stage,
+        ms.hash.clone(),
+        with_resources(&ms.container, ms_host)?,
+    );
+    Ok((LinkedPair { mesh, pixel }, bytes))
+}
