+            super::validator::Validator::default_path().as_deref(),
+        ) {
+            v.validate(&mut linked_ms.dxil.clone()).unwrap();
+            v.validate(&mut linked_ps.dxil.clone()).unwrap();
+            v.validate(&mut depth.dxil.clone()).unwrap();
+        }
+    }
