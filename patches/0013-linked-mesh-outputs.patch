+/// Keeps only arbitrary (`kind == 0`) signature elements whose semantic has at
+/// least one channel read in `keep`, trimming unread leading and trailing
+/// channels (the element keeps its register; elements packed beside it in
+/// that row keep theirs). System values (`kind != 0`) stay untouched.
+/// Channels between two read ones stay: an element is one contiguous range.
+pub(crate) fn prune_signature(elements: &mut Vec<SigElement>, keep: &KeptOutputs) {
+    elements.retain_mut(|e| {
+        if e.kind != 0 {
