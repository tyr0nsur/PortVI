+        let used = keep.get(&key).copied().unwrap_or(0) & 0xF;
+        let declared = ((1u8 << e.cols) - 1) << e.col;
+        let rel = (used & declared) >> e.col;
+        if rel == 0 {
+            return false;
+        }
+        let first = rel.trailing_zeros() as u8;
+        let last = 7 - rel.leading_zeros() as u8;
+        let cols = last - first + 1;
+        e.col += first;
+        e.cols = cols;
+        // `usage` is relative to `col`: re-base it on the trimmed range.
+        e.usage = (e.usage >> first) & ((1u8 << cols) - 1);
+        true
+    });
