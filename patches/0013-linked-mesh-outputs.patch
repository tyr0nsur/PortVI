+/// Semantic key `(UPPERCASE_NAME, index)` -> 4-bit absolute channel mask of
+/// arbitrary (`kind == 0`) inputs read by the paired pixel shader.
+pub(crate) type KeptOutputs = HashMap<(String, u32), u8>;
