+/// Console shader containers made from GFX10 words, laid out as this
+/// module reads them (`DXIL` part with an `XDAT` index, an `XBCH` blob,
+/// one `FSSM` program record and its stage data) plus the signature parts:
+/// for tests that go through the real entry points ([`crate::emit::translate`],
+/// [`crate::emit::translate_linked`]) here and in `victory-gpu` (feature
+/// `fixtures`).
+#[cfg(any(test, feature = "fixtures"))]
+pub mod fixture {
+    use super::*;
+
+    /// One 32-bit float row of an `ISG1`/`OSG1`/`PSG1` part.
+    #[derive(Debug, Clone, Copy)]
+    pub struct Row {
+        pub name: &'static str,
+        pub index: u32,
+        /// The D3D system value (0 arbitrary, 1 position, 64 target).
+        pub system_value: u32,
+        pub register: u32,
+        pub mask: u8,
+    }
+
+    /// A signature part with `rows`.
+    pub fn signature(rows: &[Row]) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.extend_from_slice(&(rows.len() as u32).to_le_bytes());
+        out.extend_from_slice(&8u32.to_le_bytes());
+        let mut names = Vec::new();
+        let base = 8 + 32 * rows.len();
+        for r in rows {
+            let name_at = (base + names.len()) as u32;
+            names.extend_from_slice(r.name.as_bytes());
+            names.push(0);
+            // Stream 0, name, index, system value, float32, register.
+            for v in [0, name_at, r.index, r.system_value, 3, r.register] {
+                out.extend_from_slice(&v.to_le_bytes());
+            }
+            out.extend_from_slice(&[r.mask, 0, 0, 0]);
+            out.extend_from_slice(&0u32.to_le_bytes());
+        }
+        out.extend_from_slice(&names);
+        out
+    }
+
+    /// A DXBC container of `parts`.
+    pub fn container(parts: &[(FourCC, &[u8])]) -> Vec<u8> {
+        let table = 0x20 + 4 * parts.len();
+        let total = table + parts.iter().map(|(_, d)| 8 + d.len()).sum::<usize>();
+        let mut out = Vec::with_capacity(total);
+        out.extend_from_slice(b"DXBC");
+        out.extend_from_slice(&[0; 16]);
+        out.extend_from_slice(&1u16.to_le_bytes());
+        out.extend_from_slice(&0u16.to_le_bytes());
+        out.extend_from_slice(&(total as u32).to_le_bytes());
+        out.extend_from_slice(&(parts.len() as u32).to_le_bytes());
+        let mut offset = table;
+        for (_, d) in parts {
+            out.extend_from_slice(&(offset as u32).to_le_bytes());
+            offset += 8 + d.len();
+        }
+        for (fourcc, d) in parts {
+            out.extend_from_slice(&fourcc.0);
+            out.extend_from_slice(&(d.len() as u32).to_le_bytes());
+            out.extend_from_slice(d);
+        }
+        out
+    }
+
+    use crate::dxbc::FourCC;
+
+    /// Stage data large enough for every stage's fields, every pixel
+    /// export patch absent.
+    fn stage_data() -> Vec<u8> {
+        let mut data = vec![0; PS_PATCHES + MRTS * PATCH_BYTES];
+        for mrt in 0..MRTS {
+            let at = PS_PATCHES + mrt * PATCH_BYTES;
+            data[at..at + 4].copy_from_slice(&u32::MAX.to_le_bytes());
+        }
+        data
+    }
+
+    /// The `DXIL` part data of one wave32 program of `stage`.
+    fn program(stage: HwStage, code: &[u32], data: &[u8]) -> Vec<u8> {
+        let code: Vec<u8> = code.iter().flat_map(|w| w.to_le_bytes()).collect();
+        let slot = |s: HwStage| SLOTS.iter().find(|x| x.0 == s).expect("a slot").1;
+        let mut payload = GRAPHICS_SLOT_COUNT.to_le_bytes().to_vec();
+        payload.resize(slot(HwStage::Cs) + 8, 0);
+        for (_, at) in SLOTS {
+            payload[at..at + 8].copy_from_slice(&ABSENT.to_le_bytes());
+        }
+        let record = payload.len();
+        let at = slot(stage);
+        payload[at..at + 8].copy_from_slice(&(record as u64).to_le_bytes());
+        let code_at = (record + RECORD_SIZE as usize + data.len()) as u64;
+        payload.extend_from_slice(&code_at.to_le_bytes());
+        payload.extend_from_slice(&(code.len() as u64).to_le_bytes());
+        payload.extend_from_slice(&[0; 4]);
+        payload.extend_from_slice(&FLAG_WAVE32.to_le_bytes());
+        payload.resize(record + RECORD_REGS, 0);
+        payload.extend_from_slice(&(32u32 | 31 << 20).to_le_bytes());
+        payload.extend_from_slice(data);
+        payload.extend_from_slice(&code);
+        let mut fssm = b"FSSM".to_vec();
+        fssm.extend_from_slice(&FSSM_VERSION.to_le_bytes());
+        fssm.extend_from_slice(&(payload.len() as u64).to_le_bytes());
+        fssm.extend_from_slice(&payload);
+        let stream = miniz_oxide::deflate::compress_to_vec_zlib(&fssm, 6);
+        let mut blob = b"XBCH".to_vec();
+        blob.extend_from_slice(&XBCH_VERSION.to_le_bytes());
+        blob.extend_from_slice(&(stream.len() as u64).to_le_bytes());
+        blob.extend_from_slice(&(fssm.len() as u64).to_le_bytes());
+        blob.extend_from_slice(&stream);
+        let mut part = vec![0u8; XDAT_OFFSET];
+        part.extend_from_slice(b"XDAT");
+        part.extend_from_slice(&1u32.to_le_bytes());
+        part.extend_from_slice(&0x24u32.to_le_bytes());
+        let offset = (part.len() + 12) as u32;
+        for v in [KIND_NATIVE, offset, blob.len() as u32] {
+            part.extend_from_slice(&v.to_le_bytes());
+        }
+        part.extend_from_slice(&blob);
+        part
+    }
+
+    /// A wave32 triangle mesh program: `outputs` are (signature row,
+    /// `exp param` index) of its per-vertex outputs.
+    pub fn mesh(
+        code: &[u32],
+        threads: u16,
+        max_vertices: u16,
+        max_primitives: u16,
+        outputs: &[(u8, u8)],
+        osg1: &[Row],
+    ) -> Vec<u8> {
+        let mut data = stage_data();
+        for (k, &(row, param)) in outputs.iter().enumerate() {
+            data[VS_OUTPUTS + 6 * k..][..6].copy_from_slice(&[6, row, param, row, 0, 0]);
+        }
+        data[VS_OUTPUT_COUNT..][..4].copy_from_slice(&(outputs.len() as u32).to_le_bytes());
+        let info = &mut data[MS_INFO..MS_INFO + 8];
+        info[0..2].copy_from_slice(&threads.to_le_bytes());
+        info[2..4].copy_from_slice(&max_vertices.to_le_bytes());
+        info[4..6].copy_from_slice(&max_primitives.to_le_bytes());
+        info[7] = 2;
+        let dxil = program(HwStage::Ms, code, &data);
+        let osg1 = signature(osg1);
+        container(&[(FourCC::DXIL, &dxil), (FourCC::OSG1, &osg1)])
+    }
+
+    /// A wave32 pixel program reading barycentrics I/J in v0/v1: `inputs`
+    /// are (signature row, channel mask, `v_interp` attribute).
+    pub fn pixel(code: &[u32], inputs: &[(u8, u8, u8)], isg1: &[Row], osg1: &[Row]) -> Vec<u8> {
+        let mut data = stage_data();
+        for (k, &(row, mask, attr)) in inputs.iter().enumerate() {
+            data[PS_INPUTS + 8 * k..][..8].copy_from_slice(&[6, row, mask, attr, 0, 0, 0, 0]);
+        }
+        data[PS_INPUT_COUNT..][..4].copy_from_slice(&(inputs.len() as u32).to_le_bytes());
+        // PERSP_CENTER_ENA: I and J in v0 and v1.
+        data[PS_INPUT_ADDR..][..4].copy_from_slice(&2u32.to_le_bytes());
+        let dxil = program(HwStage::Ps, code, &data);
+        let (isg1, osg1) = (signature(isg1), signature(osg1));
+        container(&[
+            (FourCC::DXIL, &dxil),
+            (FourCC::ISG1, &isg1),
+            (FourCC::OSG1, &osg1),
+        ])
+    }
+
+    /// `exp prim` corner indices of triangle (0, 1, 2).
+    pub const TRIANGLE: u32 = 1 << 10 | 2 << 20;
+
+    fn texcoord(index: u32, register: u32) -> Row {
+        Row {
+            name: "TEXCOORD",
+            index,
+            system_value: 0,
+            register,
+            mask: 0xF,
+        }
+    }
+
+    const POSITION: Row = Row {
+        name: "SV_Position",
+        index: 0,
+        system_value: 1,
+        register: 0,
+        mask: 0xF,
+    };
+
+    /// A mesh program of `threads` lanes declaring `SV_Position` (row 0)
+    /// and 16 `float4` `TEXCOORD0..15` (rows 1..=16): 68 components, so
+    /// 34,816 bytes at 128 vertices. Each lane writes its own vertex,
+    /// (lane & 1 ? 3 : -1, lane & 2 ? 3 : -1, 0.5, 1), and primitive,
+    /// triangle (0, 1, 2) covering the target; `TEXCOORD0` is
+    /// (1, 0.5, 0, 0), `TEXCOORD15` (0, 0, 0.25, 1), the others 0.
+    pub fn wide_mesh(threads: u16, max_vertices: u16, max_primitives: u16) -> Vec<u8> {
+        wide_mesh_with_export(threads, max_vertices, max_primitives, 0xF)
+    }
+
+    /// Like `wide_mesh`, with a selectable channel mask on TEXCOORD0.
+    pub fn wide_mesh_with_export(threads: u16, max_vertices: u16, max_primitives: u16, mask: u8) -> Vec<u8> {
+        let mut words = vec![
+            0xD765_0001u32, // v_mbcnt_lo_u32_b32 v1, -1, 0
+            0x0001_00C1,
+            0x3604_0281, // v_and_b32 v2, 1, v1
+            0x3606_0282, // v_and_b32 v3, 2, v1
+            0x7E04_0D02, // v_cvt_f32_u32 v2, v2
+            0x7E06_0D03, // v_cvt_f32_u32 v3, v3
+            0x1008_04F6, // v_mul_f32 v4, 4.0, v2
+            0x0608_08F3, // v_add_f32 v4, -1.0, v4
+            0x100A_06F4, // v_mul_f32 v5, 2.0, v3
+            0x060A_0AF3, // v_add_f32 v5, -1.0, v5
+            0x7E0C_02F0, // v_mov_b32 v6, 0.5
+            0x7E0E_02F2, // v_mov_b32 v7, 1.0
+            0x7E10_02FF, // v_mov_b32 v8, 0.25
+            0.25f32.to_bits(),
+            0x7E12_02FF, // v_mov_b32 v9, TRIANGLE
+            TRIANGLE,
+            0x7E14_0280, // v_mov_b32 v10, 0.0
+        ];
+        // param0 = (1.0, 0.5, 0.0, 0.0)
+        words.extend([0xF800_0000 | (32 << 4) | u32::from(mask), 0x0A0A_0607]);
+        // param1..14 = 0
+        for k in 1..15u32 {
+            words.extend([0xF800_000F | ((32 + k) << 4), 0x0A0A_0A0A]);
+        }
+        // param15 = (0.0, 0.0, 0.25, 1.0)
+        words.extend([0xF800_000F | ((32 + 15) << 4), 0x0708_0A0A]);
+        words.extend([
+            0xF800_0941, // exp prim v9, off, off, off done
+            0x0000_0009,
+            0xF800_08CF, // exp pos0 v4, v5, v6, v7 done
+            0x0706_0504,
+            0xBF81_0000, // s_endpgm
+        ]);
+        let outputs: Vec<(u8, u8)> = (0..16u8).map(|k| (k + 1, k)).collect();
+        let mut osg1 = vec![POSITION];
+        osg1.extend((0..16).map(|k| texcoord(k, k + 1)));
+        mesh(&words, threads, max_vertices, max_primitives, &outputs, &osg1)
+    }
+
+    /// A pixel program declaring `SV_Position` and `TEXCOORD0..declared-1`
+    /// (rows 1..=declared, `float4`, read as attributes 0..declared-1) that
+    /// sums the (`TEXCOORD` index, channel) pairs of `reads` into v2
+    /// (`exact` reads go to v2..v5 instead, at most four) and exports
+    /// (v2, v3, v4, v5) to `SV_Target0`.
+    pub fn reading_pixel(declared: u8, reads: &[(u8, u8)], exact: bool) -> Vec<u8> {
+        // v_interp_p1_f32 / v_interp_p2_f32 of attribute `attr`, channel
+        // `ch`, into `vdst`.
+        let p1 = |vdst: u32, attr: u32, ch: u32| 0xC800_0000u32 | vdst << 18 | attr << 10 | ch << 8;
+        let p2 = |vdst: u32, attr: u32, ch: u32| 0xC801_0001u32 | vdst << 18 | attr << 10 | ch << 8;
+        let mut words = vec![
+            0x7E04_0280u32, // v_mov_b32 v2, 0
+            0x7E06_0280,    // v_mov_b32 v3, 0
+            0x7E08_0280,    // v_mov_b32 v4, 0
+            0x7E0A_0280,    // v_mov_b32 v5, 0
+        ];
+        for (k, &(attr, ch)) in reads.iter().enumerate() {
+            let (attr, ch) = (u32::from(attr), u32::from(ch));
+            if exact {
+                let v = 2 + k as u32;
+                words.extend([p1(v, attr, ch), p2(v, attr, ch)]);
+            } else {
+                words.extend([p1(6, attr, ch), p2(6, attr, ch)]);
+                words.push(0x0604_0506); // v_add_f32 v2, v6, v2
+            }
+        }
+        words.extend([
+            0xF800_180F,
+            0x0504_0302, // exp mrt0 v2, v3, v4, v5 done vm
+            0xBF81_0000, // s_endpgm
+        ]);
+        let inputs: Vec<(u8, u8, u8)> = (0..declared).map(|k| (k + 1, 0xF, k)).collect();
+        let mut isg1 = vec![POSITION];
+        isg1.extend((0..u32::from(declared)).map(|k| texcoord(k, k + 1)));
+        let target = Row {
+            name: "SV_Target",
+            index: 0,
+            system_value: 64,
+            register: 0,
+            mask: 0xF,
+        };
+        pixel(&words, &inputs, &isg1, &[target])
+    }
+}
