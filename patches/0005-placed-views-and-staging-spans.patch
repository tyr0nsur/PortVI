@@ -469,4 +469,21 @@ fn words<const N: usize>(desc: *const [u32; N]) -> Option<[u32; N]> {
 }

+/// Read defined resource fields without copying ABI padding into the interned view.
+fn placed_resource_words(desc: *const [u32; 14]) -> Option<[u32; 14]> {
+    if desc.is_null() {
+        return None;
+    }
+    let mut fields = [0u32; 14];
+    let from = desc.cast::<u8>();
+    let to = fields.as_mut_ptr().cast::<u8>();
+    // SAFETY: a 56-byte ResourceDesc; copying bytes also permits an unaligned
+    // source. Dimension occupies bytes 0..4, alignment through flags 8..52.
+    unsafe {
+        std::ptr::copy_nonoverlapping(from, to, 4);
+        std::ptr::copy_nonoverlapping(from.add(8), to.add(8), 44);
+    }
+    Some(fields)
+}
+
 /// Device method.
 pub(crate) extern "system" fn create_cbv(_: This, desc: *const [u32; 4], handle: u64) {
@@ -508,5 +525,5 @@ pub(crate) extern "system" fn create_placed_srv(
     handle: u64,
 ) {
-    if let (Some(resource), Some(desc)) = (words(resource), words(desc)) {
+    if let (Some(resource), Some(desc)) = (placed_resource_words(resource), words(desc)) {
         record(handle, View::Placed(false, resource, desc));
     }
@@ -519,5 +536,5 @@ pub(crate) extern "system" fn create_placed_uav(
     handle: u64,
 ) {
-    if let (Some(resource), Some(desc)) = (words(resource), words(desc)) {
+    if let (Some(resource), Some(desc)) = (placed_resource_words(resource), words(desc)) {
         record(handle, View::Placed(true, resource, desc));
     }
@@ -874,3 +891,42 @@ mod tests {
         assert_ne!(slot::<extern "system" fn(This) -> u64>(h, 0x48)(h), address);
     }
+
+    #[cfg(windows)]
+    #[test]
+    fn placed_texture_padding_reuses_the_resource_across_views() {
+        // The runtime caches the resource for this process. Keep its aligned
+        // backing allocation alive for the same lifetime.
+        static TITLE_ADDRESS: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+        let addr = *TITLE_ADDRESS.get_or_init(|| {
+            Box::leak(Box::new(crate::resource::Memory::zeroed(65536, 65536).unwrap())).address()
+        });
+        let mut srv = [0u32; 16];
+        (srv[10], srv[11]) = (addr as u32, (addr >> 32) as u32);
+        let shape = [3, 0, 0, 0, 8, 0, 4, 0x1_0001, 80, 1, 0, 0x105, 0, 0];
+        let mut padded = shape;
+        padded[1] = 0x1234_5678;
+        padded[13] = 0x9abc_def0;
+        let record = |desc: &[u32; 14], unordered: bool| {
+            let mut record = [0u64; 4];
+            let slot = record.as_mut_ptr() as u64;
+            if unordered {
+                create_placed_uav(std::ptr::null(), desc, &srv, slot);
+            } else {
+                create_placed_srv(std::ptr::null(), desc, &srv, slot);
+            }
+            view(slot).unwrap()
+        };
+        let object = |view: &View| match host::placed_texture(view) {
+            Some(View::Shader(resource, _)) => resource,
+            _ => panic!("placed texture resource missing"),
+        };
+        let first = record(&shape, false);
+        let second = record(&padded, false);
+        assert_eq!(object(&first), object(&second), "padding allocated a second resource");
+        assert_eq!(first, second);
+        assert_eq!(record(&shape, true), record(&padded, true));
+        let mut wider = padded;
+        wider[4] = 16;
+        assert_ne!(object(&first), object(&record(&wider, false)));
+    }
 }
