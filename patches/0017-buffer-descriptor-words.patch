+    address: u64,
+    /// Its length in bytes.
+    bytes: u64,
+    /// NUM_RECORDS: bytes for raw views, elements for typed and structured
+    /// ones (as the console's driver counts them); a raw range past
+    /// `u32::MAX` bytes saturates.
