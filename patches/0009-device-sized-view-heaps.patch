+/// `f`, with translations and probe-host heaps on this thread for view
+/// heaps of `views` slots: for checks that run on more than one device
+/// (hardware, WARP) in one process.
+pub fn with_heap_views<R>(views: u32, f: impl FnOnce() -> R) -> R {
+    struct Restore(Option<u32>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            SCOPED_HEAP_VIEWS.with(|s| s.set(self.0));
+        }
+    }
+    let _restore = Restore(SCOPED_HEAP_VIEWS.with(|s| s.replace(Some(clamp_heap_views(views)))));
+    f()
