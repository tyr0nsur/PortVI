+
+/// Translations from now on are for view heaps of `views` slots (clamped
+/// to [`HEAP_SAMPLERS`]..=[`HEAP_VIEWS_MAX`]): what the host device makes,
+/// said once when it is made, before the first translation.
+pub fn set_heap_views(views: u32) {
+    HEAP_VIEWS.store(clamp_heap_views(views), std::sync::atomic::Ordering::Relaxed);
