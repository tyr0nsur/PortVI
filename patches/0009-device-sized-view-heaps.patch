+/// The view heap size translations are made for: the device's own, and a
+/// check's on its thread only, as long as it runs.
+#[test]
+fn heap_views_are_set_per_device_and_scoped_per_thread() {
+    use super::{HEAP_VIEWS_MAX, HEAP_VIEWS_PORTABLE, heap_views, null_buffer_view, with_heap_views};
+    let outer = heap_views();
+    let inner = with_heap_views(HEAP_VIEWS_PORTABLE, || {
+        let other = std::thread::spawn(heap_views).join().unwrap();
+        assert_eq!(other, outer, "another thread keeps the process-wide size");
+        (heap_views(), null_buffer_view())
+    });
+    assert_eq!(inner, (HEAP_VIEWS_PORTABLE, HEAP_VIEWS_PORTABLE - 2));
+    assert_eq!(heap_views(), outer, "restored");
+    assert_eq!(with_heap_views(u32::MAX, heap_views), HEAP_VIEWS_MAX, "clamped");
+    for (label, warp) in [("hardware", false), ("warp", true)] {
+        if let Ok(host) = Host::new(warp) {
+            let limit = host.view_heap_limit();
+            assert!([HEAP_VIEWS_MAX, HEAP_VIEWS_PORTABLE].contains(&limit), "{label}: {limit}");
+        }
+    }
+}
