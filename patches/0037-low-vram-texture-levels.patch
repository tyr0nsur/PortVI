+/// How many of its largest levels the host copy of a texture described by
+/// `desc` may leave out (`VICTORY_TEXTURE_DROP_MIPS=N`, at most 4; 0, the
+/// default, leaves out none), for cards whose memory budget the textures
+/// a title picks by index overrun. Each level left out divides the
+/// texture's bytes by about four. Only 2D textures the title fills itself
+/// (no render target, depth or unordered access), arrays and cubes
+/// included, single-sampled, at least 512 texels on their shorter side,
+/// whose sides the levels left out halve exactly into whole 4-texel
+/// blocks: host level `m` is then title level `m + N` texel for texel.
+/// The presented picture, render targets and unordered textures keep
+/// their size; sampled textures lose detail. The host texture decides
+/// ([`dropped`]): `shared_texture` leaves out levels only for the first
+/// host texture of a memory no title texture writes. After
+/// fxceless/victory-fork#610.
+pub(crate) fn drop_levels(desc: &ResourceDesc) -> u32 {
+    static N: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    let n = *N.get_or_init(|| {
+        std::env::var("VICTORY_TEXTURE_DROP_MIPS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u32>().ok())
+            .unwrap_or(0)
+            .min(4)
+    });
+    drop_levels_of(desc, n)
+}
+
+/// [`drop_levels`] for `n` levels asked.
+fn drop_levels_of(desc: &ResourceDesc, n: u32) -> u32 {
+    const TEXTURE_2D: u32 = 3;
+    const WRITTEN: u32 = 0x7; // render target, depth, unordered access
+    if n == 0 || desc.dimension != TEXTURE_2D || desc.flags & WRITTEN != 0 || desc.sample_count > 1 {
+        return 0;
+    }
+    let n = n.min(mip_count(desc).saturating_sub(1));
+    let (w, h) = (desc.width, u64::from(desc.height));
+    let whole = |side: u64| side.is_multiple_of(4 << n);
+    if n == 0 || w.min(h) < 512 || !whole(w) || !whole(h) {
+        return 0;
+    }
+    n
+}
