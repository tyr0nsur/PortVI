+    /// Levels are left out only of 2D textures the title fills, of 512
+    /// texels or more on the shorter side, whose sides halve into whole
+    /// blocks, keeping at least one level; render targets, depth, unordered
+    /// textures, multisampled and 3D ones keep every level.
+    #[test]
+    fn only_large_filled_2d_textures_leave_out_levels() {
+        let t = |w, h, mips| texture(w, h, 71, mips);
+        assert_eq!(drop_levels_of(&t(2048, 2048, 12), 0), 0, "off by default");
+        assert_eq!(drop_levels_of(&t(2048, 2048, 12), 1), 1);
+        assert_eq!(drop_levels_of(&t(2048, 2048, 12), 2), 2);
+        assert_eq!(drop_levels_of(&t(2048, 2048, 0), 2), 2, "a full chain");
+        assert_eq!(drop_levels_of(&t(2048, 1024, 2), 4), 1, "one level kept");
+        assert_eq!(drop_levels_of(&t(2048, 2048, 1), 1), 0, "no smaller level");
+        assert_eq!(drop_levels_of(&t(2048, 256, 12), 1), 0, "short side under 512");
+        assert_eq!(drop_levels_of(&t(1000, 1000, 10), 1), 1);
+        assert_eq!(drop_levels_of(&t(1000, 1000, 10), 2), 0, "1000 / 4 is not whole 4-texel blocks");
+        assert_eq!(drop_levels_of(&t(1022, 1024, 10), 1), 0, "odd blocks");
+        for flags in [1, 2, 4] {
+            let written = ResourceDesc { flags, ..t(2048, 2048, 12) };
+            assert_eq!(drop_levels_of(&written, 1), 0, "flags {flags:#x}");
+        }
+        let msaa = ResourceDesc { sample_count: 4, ..t(2048, 2048, 1) };
+        assert_eq!(drop_levels_of(&msaa, 1), 0);
+        let volume = ResourceDesc { dimension: TEXTURE_3D, ..t(2048, 2048, 12) };
+        assert_eq!(drop_levels_of(&volume, 1), 0);
+        let array = ResourceDesc { depth_or_array_size: 6, ..t(1024, 1024, 11) };
+        assert_eq!(drop_levels_of(&array, 1), 1, "arrays and cubes too");
+    }
