+        copy(list, &level(15), 0, 0, 0, &upload(1024), null.cast());
+        let region = [1, 1, 0, 3, 3, 1];
+        copy(list, &read(512), 0, 0, 0, &level(15), &region);
+        copy(list, &read(2048), 0, 0, 0, &level(7), &region);
