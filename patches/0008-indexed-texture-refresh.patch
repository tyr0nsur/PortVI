+#[cfg(test)]
+mod fingerprint_tests {
+    use super::fingerprint;
+
+    #[test]
+    fn a_small_upload_covers_its_last_byte_and_a_late_middle_write() {
+        let mut data = vec![0x55u8; 48 << 10];
+        let at = data.as_ptr() as u64;
+        let bytes = data.len() as u64;
+        let original = fingerprint(at, bytes);
+        data[19_333] ^= 1;
+        assert_ne!(fingerprint(at, bytes), original);
+        data[19_333] ^= 1;
+        assert_eq!(fingerprint(at, bytes), original);
+        *data.last_mut().unwrap() ^= 1;
+        assert_ne!(fingerprint(at, bytes), original);
+    }
+
+    #[test]
+    fn a_large_upload_samples_the_start_middle_and_end() {
+        let mut data = vec![0x55u8; 128 << 10];
+        let at = data.as_ptr() as u64;
+        let bytes = data.len() as u64;
+        let original = fingerprint(at, bytes);
+        for index in [0, data.len() / 2, data.len() - 1] {
+            data[index] ^= 1;
+            assert_ne!(fingerprint(at, bytes), original);
+            data[index] ^= 1;
+        }
+        data[32 << 10] ^= 1;
+        assert_eq!(fingerprint(at, bytes), original, "outside the three sample windows");
+    }
