+/// A whole texture upload that can be checked for late writes without a descriptor update.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct TextureCheck {
+    pub(crate) address: u64,
+    pub(crate) bytes: u64,
+    pub(crate) fingerprint: u64,
+    pub(crate) uploaded: u64,
+    next: usize,
+}
+
+impl TextureCheck {
+    // Each interval starts with the preceding check, even if a busy frame delayed it.
+    const INTERVALS: [u64; 5] = [4, 12, 40, 120, 400];
+
+    pub(crate) fn new(address: u64, bytes: u64, fingerprint: u64, frame: u64) -> Self {
+        Self { address, bytes, fingerprint, uploaded: frame, next: 0 }
+    }
+
+    pub(crate) fn schedule(mut self, frame: u64) -> Option<(u64, Self)> {
+        let wait = *Self::INTERVALS.get(self.next)?;
+        self.next += 1;
+        Some((frame.saturating_add(wait), self))
+    }
+}
