+            assert_eq!(queue.due(expected, 1), [(7, write)]);
+            assert_eq!(queue.census(expected)[2], 0);
+            check = queue.take_check(7, write).unwrap();
+            frame = expected;
+        }
+        queue.recheck(7, write, frame, check);
