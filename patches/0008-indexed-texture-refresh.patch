+    #[test]
+    fn unchanged_uploads_retire_after_five_checks() {
+        let mut queue = TextureQueue::default();
+        queue.written(7, 10, 10, false);
+        let write = queue.due(10, 1)[0].1;
+        let mut check = TextureCheck::new(0x4000, 128, 42, 10);
+        let mut frame = 10;
+        for expected in [14, 26, 66, 186, 586] {
