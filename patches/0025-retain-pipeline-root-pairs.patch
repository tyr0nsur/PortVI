+    /// Retain each pipeline and root pair until reset. Two names may refer to
+    /// the same host objects, so record every bound name for submission reports.
+    pub(crate) fn bind_pipeline(
+        &self,
+        name: &str,
+        pso: &ID3D12PipelineState,
+        root: &ID3D12RootSignature,
+    ) {
+        self.used_pipeline(name);
+        let mut deferred = self.deferred();
+        if deferred.bound.insert((pso.as_raw() as usize, root.as_raw() as usize)) {
+            deferred.kept.push(pso.clone().into());
+            deferred.kept.push(root.clone().into());
+        }
+    }
+
     fn deferred(&self) -> std::sync::MutexGuard<'_, Deferred> {
         self.deferred.lock().unwrap_or_else(|e| e.into_inner())
     }
