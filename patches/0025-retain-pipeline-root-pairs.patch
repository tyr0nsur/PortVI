+#[cfg(test)]
+mod pipeline_retention {
+    use super::*;
+
+    /// An empty compute shader with root signature `rs` inside; `threads`
+    /// tells pipelines apart.
+    fn compute(rs: &str, threads: u32) -> ID3DBlob {
+        let source =
+            format!("[RootSignature(\"{rs}\")] [numthreads({threads}, 1, 1)] void main() {{}}");
+        let mut code: Option<ID3DBlob> = None;
+        // SAFETY: the source and names outlive the call.
+        unsafe {
+            D3DCompile(
+                source.as_ptr().cast(),
+                source.len(),
+                s!("retention"),
+                None,
+                None,
+                s!("main"),
+                s!("cs_5_1"),
+                0,
+                0,
+                &mut code,
+                None,
+            )
+        }
+        .unwrap();
+        code.unwrap()
+    }
+
+    fn root(host: &Host, blob: &ID3DBlob) -> ID3D12RootSignature {
+        // SAFETY: a compiled shader with its root signature inside.
+        unsafe {
+            host.device.CreateRootSignature(
+                0,
+                std::slice::from_raw_parts(
+                    blob.GetBufferPointer().cast::<u8>(),
+                    blob.GetBufferSize(),
+                ),
+            )
+        }
+        .unwrap()
+    }
+
+    fn pipeline(host: &Host, blob: &ID3DBlob, root: &ID3D12RootSignature) -> ID3D12PipelineState {
+        let desc = D3D12_COMPUTE_PIPELINE_STATE_DESC {
+            // SAFETY: borrowed for the call.
+            pRootSignature: unsafe { std::mem::transmute_copy(root) },
+            // SAFETY: the blob's own bytes, alive for the call.
+            CS: unsafe {
+                D3D12_SHADER_BYTECODE {
+                    pShaderBytecode: blob.GetBufferPointer(),
+                    BytecodeLength: blob.GetBufferSize(),
+                }
+            },
+            ..Default::default()
+        };
+        // SAFETY: a complete description.
+        unsafe { host.device.CreateComputePipelineState(&desc) }.unwrap()
+    }
+
+    /// Strong references to `object`, not counting the one asked with.
+    fn refs(object: &impl Interface) -> u32 {
+        let unknown: windows::core::IUnknown = object.cast().unwrap();
+        // SAFETY: a balanced AddRef and Release on a live object.
+        unsafe {
+            (unknown.vtable().AddRef)(unknown.as_raw());
+            (unknown.vtable().Release)(unknown.as_raw()) - 1
+        }
+    }
+
+    fn names(list: &HostList) -> Vec<String> {
+        list.pipelines.lock().unwrap().iter().cloned().collect()
+    }
+
+    /// A list binding pipelines A, B, A with root X keeps each pair once
+    /// (one strong reference per object per pair) and names A and B once;
+    /// A bound with another root Y keeps Y too. The references last through
+    /// submission; the reset releases them all and the next binds keep
+    /// again. A pipeline the test releases before the list is submitted runs.
+    #[test]
+    fn a_list_keeps_each_bound_pipeline_and_root_once_until_reset() {
+        let Some(host) = host() else {
+            eprintln!("skipped pipeline retention: no host D3D12 device");
+            return;
+        };
+        let x_blob = compute("RootFlags(0)", 1);
+        let (x, y) = (
+            root(host, &x_blob),
+            root(
+                host,
+                &compute("RootFlags(0), RootConstants(num32BitConstants=1, b0)", 1),
+            ),
+        );
+        let (a, b) = (
+            pipeline(host, &x_blob, &x),
+            pipeline(host, &compute("RootFlags(0)", 2), &x),
+        );
+        assert_ne!(a.as_raw(), b.as_raw(), "two pipelines");
+        assert_ne!(x.as_raw(), y.as_raw(), "two root signatures");
+        let fresh = [refs(&a), refs(&b), refs(&x), refs(&y)];
+        let count = |list: &HostList| {
+            let d = list.deferred();
+            (d.kept.len(), d.bound.len())
+        };
+
+        let list = host.new_list().unwrap();
+        // SAFETY: an open list, live root signature and pipelines.
+        unsafe {
+            list.list.SetComputeRootSignature(&x);
+            for p in [&a, &b, &a] {
+                list.list.SetPipelineState(p);
+                list.list.Dispatch(1, 1, 1);
+            }
+        }
+        // Whatever recording itself holds, the list's own references on top.
+        let base = [refs(&a), refs(&b), refs(&x), refs(&y)];
+        let held = |d: [u32; 4]| {
+            [refs(&a), refs(&b), refs(&x), refs(&y)] == std::array::from_fn(|i| base[i] + d[i])
+        };
+
+        list.bind_pipeline("a", &a, &x);
+        assert!(held([1, 0, 1, 0]), "A and X kept");
+        list.bind_pipeline("b", &b, &x);
+        assert!(held([1, 1, 2, 0]), "B and X kept for B");
+        list.bind_pipeline("a", &a, &x);
+        assert!(held([1, 1, 2, 0]), "A, B, A: A not kept again");
+        assert_eq!(count(&list), (4, 2));
+        assert_eq!(names(&list), ["a", "b"]);
+        list.bind_pipeline("a", &a, &y);
+        assert!(held([2, 1, 2, 1]), "A with another root: that root kept");
+        assert_eq!(count(&list), (6, 3));
+        list.bind_pipeline("alternate", &a, &y);
+        assert_eq!(count(&list), (6, 3));
+        assert_eq!(names(&list), ["a", "alternate", "b"]);
+
+        list.close();
+        host.execute(&[&list]);
+        assert!(held([2, 1, 2, 1]), "kept through submission");
+        list.reset();
+        assert_eq!(
+            [refs(&a), refs(&b), refs(&x), refs(&y)],
+            fresh,
+            "all released at the reset"
+        );
+        assert_eq!(count(&list), (0, 0));
+        assert!(names(&list).is_empty() && list.is_empty());
+
+        // After the reset the same pair is kept and named again, and keeps a
+        // pipeline alive that the test releases before submitting.
+        let b_raw = b.as_raw() as usize;
+        // SAFETY: an open list, live root signature and pipeline.
+        unsafe {
+            list.list.SetComputeRootSignature(&x);
+            list.list.SetPipelineState(&b);
+            list.list.Dispatch(1, 1, 1);
+        }
+        list.bind_pipeline("b", &b, &x);
+        assert_eq!(count(&list), (2, 1));
+        assert_eq!(names(&list), ["b"]);
+        let before = refs(&b);
+        drop(b);
+        {
+            let deferred = list.deferred();
+            let kept_b = deferred
+                .kept
+                .iter()
+                .find(|object| object.as_raw() as usize == b_raw)
+                .expect("the list retains B");
+            assert_eq!(
+                refs(kept_b),
+                before - 1,
+                "releasing the title's reference drops one"
+            );
+        }
+        list.close();
+        host.execute(&[&list]);
+        list.reset();
+        assert_eq!(
+            [refs(&a), refs(&x), refs(&y)],
+            [fresh[0], fresh[2], fresh[3]]
+        );
+    }
+}
 
