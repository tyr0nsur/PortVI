+/// D3D12 includes padding between subresources, but the allocation ends
+/// after the data bytes of the final row, which may be shorter than RowPitch.
+fn staging_slice<'a>(
+    upload: &'a mut [u8],
+    footprints: &[D3D12_PLACED_SUBRESOURCE_FOOTPRINT],
+    index: usize,
+) -> Option<&'a mut [u8]> {
+    let start = footprints.get(index)?.Offset as usize;
+    let end = footprints.get(index + 1).map_or(upload.len(), |next| next.Offset as usize);
+    upload.get_mut(start..end)
+}
