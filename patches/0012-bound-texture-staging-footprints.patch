+#[cfg(test)]
+mod staging_tests {
+    use super::*;
+    use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT_BC4_UNORM, DXGI_SAMPLE_DESC};
+
+    #[test]
+    fn a_bc4_mip_uses_only_the_bytes_in_its_upload_footprint() {
+        let host = host().expect("D3D12 device for texture footprints");
+        let desc = D3D12_RESOURCE_DESC {
+            Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+            Width: 8, Height: 4, DepthOrArraySize: 1, MipLevels: 2, Format: DXGI_FORMAT_BC4_UNORM,
+            SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+            ..Default::default()
+        };
+        let mut footprints = [D3D12_PLACED_SUBRESOURCE_FOOTPRINT::default(); 2];
+        let mut rows = [0; 2];
+        let mut row_bytes = [0; 2];
+        let mut total = 0;
+        // SAFETY: one output for each of the two described subresources.
+        unsafe {
+            host.device.GetCopyableFootprints(&desc, 0, 2, 0, Some(footprints.as_mut_ptr()),
+                Some(rows.as_mut_ptr()), Some(row_bytes.as_mut_ptr()), Some(&mut total));
+        }
+        assert_eq!(row_bytes, [16, 8]);
+        assert_eq!(rows, [1, 1]);
+        assert_eq!(total - footprints[1].Offset, 8);
+        assert_eq!(footprints[1].Footprint.RowPitch, 256);
+        let mut upload = vec![0x91; total as usize];
+        let second = footprints[1].Offset as usize;
+        assert_eq!(staging_slice(&mut upload, &footprints, 0).unwrap().len(), second);
+        let tail = staging_slice(&mut upload, &footprints, 1).unwrap();
+        assert_eq!(tail.len(), 8);
+        tail.fill(0xbe);
+        assert!(upload[..second].iter().all(|&v| v == 0x91));
+        assert_eq!(&upload[second..], &[0xbe; 8]);
+    }
+}
