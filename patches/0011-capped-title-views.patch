+                    roots: vec![(0, Root::Constants(ud)), (1, Root::View { srv: true, data: strides })],
+                    views: &views, samplers: &[], groups: [1, 1, 1],
+                }).unwrap();
+                let expected: Vec<u32> = (0..32).map(|lane| if index == 0 { 200 + lane } else { 0 }).collect();
+                assert_eq!(words[0], expected, "direct index {index}, WARP {warp}");
+            }
+        });
+        ran += 1;
+    }
+    assert!(ran > 0, "no D3D12 adapter");
+}
