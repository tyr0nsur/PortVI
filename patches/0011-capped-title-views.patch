+fn direct_title_indices_stop_before_host_tables() {
+    let data: Vec<u32> = (0..32).flat_map(|lane| [100 + lane, 200 + lane, 300 + lane]).collect();
+    let views = [
+        View::Buffer { data: &data, stride: Stride::Structured(12) },
+        View::Buffer { data: &data, stride: Stride::Structured(12) },
+        View::RawUav(32), View::NullBuffers,
+    ];
+    let _serial = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let mut ran = 0;
+    for warp in [false, true] {
+        let Ok(host) = Host::new(warp) else { continue };
+        // Slot zero is mirrored. Slot one contains real data but belongs to
+        // the host. Both cases must write their result through the table at two.
+        super::with_view_heap(2048, 1, || {
+            let shader = build(
+                HEAP_ELEMENT_WAVE32,
+                vec![param(RootType::Constants, 0), param(RootType::ResourceHeap, 1),
+                     param(RootType::Table, 2)],
+                vec![entry(ResourceType::Uav, 4, 2)], 32,
+            );
+            let (root, pso) = host.compute_pipeline(&shader).unwrap();
+            for index in [0, 1] {
+                let mut ud = vec![0; shader.user_data_dwords().max(1) as usize];
+                for u in &shader.user_data {
+                    ud[u.index as usize] = match u.root {
+                        RootType::Constants => index,
+                        RootType::Table => 2 * 32,
+                        other => panic!("unexpected root {other:?}"),
+                    };
+                }
+                let mut strides = vec![0; 2048];
+                strides[..3].copy_from_slice(&[12, 12, 4]);
