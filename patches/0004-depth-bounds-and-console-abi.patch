+    #[test]
+    fn reset_x_is_at_its_slot_in_both_layouts() {
+        let null = std::ptr::null();
+        let mut allocator = null;
+        assert_eq!(
+            create_allocator(null, 0, &ALLOCATOR_IIDS[0], &mut allocator),
+            S_OK
+        );
+        let mut list = null;
+        let hr = create_list(null, 0, 0, allocator, null, &LIST_IIDS[0], &mut list);
+        assert_eq!(hr, S_OK);
+        // SAFETY: the list is ours.
+        let uploads = || unsafe { &(*list.cast::<List>()).uploads }.lock().unwrap().len();
+        assert_ne!(LIST_FUNCTIONS.0.as_ptr(), NEWER_LIST_FUNCTIONS.0.as_ptr());
+        let method = reset_x as *const ();
+        for (table, at, not_at) in [(&LIST_FUNCTIONS, 137, 139), (&NEWER_LIST_FUNCTIONS, 139, 137)] {
+            assert_eq!(table.0[at], method);
+            assert_ne!(table.0[not_at], method);
+            // SAFETY: the slot holds `reset_x`, checked above.
+            let reset_x = unsafe {
+                std::mem::transmute::<*const (), extern "system" fn(This, This, This, u32) -> HRESULT>(
+                    table.0[at],
+                )
+            };
+            // Something recorded, then the list closed (0x48, the same slot
+            // in both layouts).
+            assert!(!allocate_upload(list, 16, 16).is_null());
+            assert_eq!(uploads(), 1);
+            assert_eq!(
+                slot::<extern "system" fn(This) -> HRESULT>(list, 0x48)(list),
+                S_OK
+            );
+            assert_eq!(reset_x(list, null, null, 0), E_INVALIDARG);
+            assert_eq!(uploads(), 1, "a refused reset keeps the recording");
+            assert_eq!(reset_x(list, allocator, null, 0), S_OK);
+            assert_eq!(uploads(), 0, "a reset lets the recording go");
+        }
+        let release = |o: This| slot::<extern "system" fn(This) -> u32>(o, 0x10)(o);
