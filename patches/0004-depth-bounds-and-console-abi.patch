+    #[test]
+    fn device_removal_reason_matches_the_host_device() {
+        let device = device();
+        let reason = slot::<extern "system" fn(This) -> HRESULT>(device, 0x128);
+        #[cfg(windows)]
+        let expected = match crate::host::host() {
+            // SAFETY: a plain query; removal is permanent, so the answer
+            // cannot change from failure back to success between calls.
+            Some(host) => match unsafe { host.device.GetDeviceRemovedReason() } {
+                Ok(()) => S_OK,
+                Err(e) => e.code().0,
+            },
+            None => S_OK,
+        };
+        #[cfg(not(windows))]
+        let expected = S_OK;
+        assert_eq!(reason(device), expected);
+    }
 }
