+        #[cfg(windows)]
+        let expected = match crate::host::host() {
+            // SAFETY: a plain query; removal is permanent, so the answer
+            // cannot change from failure back to success between calls.
+            Some(host) => match unsafe { host.device.GetDeviceRemovedReason() } {
+                Ok(()) => S_OK,
+                Err(e) => e.code().0,
+            },
+            None => S_OK,
+        };
