+    #[test]
+    fn timestamp_frequency_is_at_its_slot_in_both_layouts() {
+        let null = std::ptr::null();
+        let desc = QueueDescX {
+            kind: 0,
+            flags: 0,
+            engine_or_pipe: 0,
+            queue: 0,
+        };
+        let mut q = null;
+        assert_eq!(create_x(null, &desc, &QUEUE_IIDS[0], &mut q), S_OK);
+        assert_ne!(FUNCTIONS.0.as_ptr(), NEWER_FUNCTIONS.0.as_ptr());
+        let method = timestamp_frequency as *const ();
+        for (table, at, not_at) in [(&FUNCTIONS, 16, 18), (&NEWER_FUNCTIONS, 18, 16)] {
+            assert_eq!(table.0[at], method);
+            assert_ne!(table.0[not_at], method);
+            // SAFETY: the slot holds `timestamp_frequency`, checked above.
+            let frequency = unsafe {
+                std::mem::transmute::<*const (), extern "system" fn(This, *mut u64) -> HRESULT>(
+                    table.0[at],
+                )
+            };
+            let mut out = u64::MAX;
+            assert_eq!(frequency(q, &mut out), S_OK);
+            assert_eq!(out, TIMESTAMP_FREQUENCY);
+            assert_eq!(out, 100_000_000);
+            assert_eq!(frequency(q, std::ptr::null_mut()), E_INVALIDARG);
+        }
+        assert_eq!(slot::<extern "system" fn(This) -> u32>(q, 0x10)(q), 0);
+    }
