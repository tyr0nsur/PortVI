+/// `OMSetDepthBounds`, for the pipelines made with the test
+/// (`crate::pipeline::host`); nothing on a host without it, whose
+/// pipelines are made without the test.
+pub(crate) fn depth_bounds(list: &HostList, min: f32, max: f32) {
+    if crate::host::host().is_some_and(|h| h.depth_bounds())
+        && let Ok(list1) = list.list.cast::<ID3D12GraphicsCommandList1>()
+    {
+        // SAFETY: an open list on a device with the depth bounds test.
+        unsafe { list1.OMSetDepthBounds(min, max) };
+    }
+}
