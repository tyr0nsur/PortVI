+/// Publish only the bytes a successful virtual write produced. A render pass
+/// can consume the pre-write notification while a read or inflate is in flight.
+fn fill_virtual(
+    out: &mut [u8],
+    fill: impl FnOnce(&mut [u8]) -> Result<usize, HRESULT>,
+    completed: impl FnOnce(&[u8]),
+) -> Result<(), HRESULT> {
+    let n = fill(out)?;
+    let written = out.get(..n).ok_or(E_INVALIDARG)?;
+    if !written.is_empty() {
+        completed(written);
+    }
+    Ok(())
+}
